@theme "bluetheme"

configuration {
  font: "Hack Nerd Font Medium 10";

  drun {
    display-name: "";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }
}

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  bg: #101628;
  fg: #cbdaf3;
  blue: #86bef7ff;
  text: #86bef7ff;

  background-color: @bg;
  text-color: @fg;
}

window {
  transparency: "real";
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  background-color: @bg;
  children: [prompt, entry];
}

entry {
  background-color: inherit;
  padding: 12px 3px;
}

prompt {
  background-color: inherit;
  padding: 12px;
}

listview {
  lines: 8;
}

element {
  background-color: @bg;   // Use your dark background for unselected cards
  children: [element-icon, element-text];
  text-color: @text;
}

element selected {
  background-color: rgba(255, 0, 0, 0.7);  // Blue highlight for selected
  text-color: @text;
}


element-icon {
  padding: 10px 10px;
}

element-text {
  padding: 10px 0;
}

element-text selected {
  text-color: @text;
}